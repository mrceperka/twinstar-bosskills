package guildtoken

import "github.com/mrceperka/twinstar-bosskills/go/internal/links"
import "github.com/mrceperka/twinstar-bosskills/go/internal/web/views/components"
import "github.com/mrceperka/twinstar-bosskills/go/internal/web/views/layouts"

type ViewModel struct {
	Meta         layouts.PageMeta
	Realm        string
	CurrentGuild string
	CurrentToken string
	StatusOK     bool
	StatusError  string
}

templ Page(vm ViewModel) {
	@layouts.Root(vm.Meta) {
		<div class="space-y-6">
			<header>
				<h1 class="text-2xl font-semibold">{ vm.Realm } / Guild token</h1>
				<p class="text-sm text-bk-muted">
					Private realms (currently MoPPvE) require a guild token to view per-guild data.
					Paste your guild name and token below. They are stored in an httpOnly cookie for 1 year.
				</p>
			</header>
			@components.Panel("Current") {
				<dl class="grid grid-cols-3 gap-x-6 gap-y-1 text-sm">
					<dt class="text-bk-muted">Guild</dt>
					<dd class="col-span-2 font-mono">
						if vm.CurrentGuild != "" {
							{ vm.CurrentGuild }
						} else {
							<span class="text-bk-muted">—</span>
						}
					</dd>
					<dt class="text-bk-muted">Token</dt>
					<dd class="col-span-2 font-mono break-all">
						if vm.CurrentToken != "" {
							{ maskToken(vm.CurrentToken) }
						} else {
							<span class="text-bk-muted">—</span>
						}
					</dd>
				</dl>
			}
			@components.Panel("Set token") {
				if vm.StatusOK {
					<div class="mb-3 rounded border border-green-500/40 bg-green-500/10 p-2 text-sm text-green-300">
						Token verified and saved.
					</div>
				}
				if vm.StatusError != "" {
					<div class="mb-3 rounded border border-red-500/40 bg-red-500/10 p-2 text-sm text-red-300">
						{ vm.StatusError }
					</div>
				}
				<form method="POST" class="space-y-3">
					<label class="block text-sm">
						<span class="text-bk-muted">Guild name</span>
						<input
							name="guild"
							type="text"
							value={ vm.CurrentGuild }
							required
							class="mt-1 w-full rounded border border-bk-border bg-bk-bg p-2 font-mono"
						/>
					</label>
					<label class="block text-sm">
						<span class="text-bk-muted">Token</span>
						<input
							name="token"
							type="text"
							autocomplete="off"
							required
							class="mt-1 w-full rounded border border-bk-border bg-bk-bg p-2 font-mono"
						/>
					</label>
					<div class="flex justify-end">
						<button type="submit" class="rounded bg-bk-accent/20 border border-bk-accent px-3 py-1 text-sm text-bk-accent">Save</button>
					</div>
				</form>
				<p class="mt-4 text-xs text-bk-muted">
					Don't have a token? Ask the realm admin, or generate one at
					<a href={ templ.SafeURL(links.GuildTokenGenerate(vm.Realm)) } class="text-bk-accent hover:underline">/guild-token/generate</a>.
				</p>
			}
		</div>
	}
}
