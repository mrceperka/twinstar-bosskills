package raids

import (
	"strconv"

	"github.com/mrceperka/twinstar-bosskills/go/internal/format"
	"github.com/mrceperka/twinstar-bosskills/go/internal/links"
	"github.com/mrceperka/twinstar-bosskills/go/internal/web/views/components"
	"github.com/mrceperka/twinstar-bosskills/go/internal/web/views/layouts"
	"github.com/mrceperka/twinstar-bosskills/go/internal/web/views/viewhelpers"
)

type ViewModel struct {
	Meta     layouts.PageMeta
	Realm    string
	Lock     LockLabel
	Raids    []Raid
	Difficulties []DifficultyChoice // header columns
}

type LockLabel struct {
	StartLabel string
	EndLabel   string
	Offset     int
}

type DifficultyChoice struct {
	Mode  int
	Label string
}

type Raid struct {
	Name   string
	Bosses []BossRow
}

type BossRow struct {
	Name     string
	RemoteID uint32
	// KillsByDifficulty[mode] = count
	KillsByDifficulty map[int]int
	Total             int
}

templ Page(vm ViewModel) {
	@layouts.Root(vm.Meta) {
		<div class="space-y-6">
			<header class="flex items-baseline justify-between">
				<h1 class="text-2xl font-semibold">{ vm.Realm } / Raids</h1>
				<div class="text-xs text-bk-muted">
					{ vm.Lock.StartLabel } → { vm.Lock.EndLabel }
					<a href={ templ.SafeURL(links.Raids(vm.Realm) + "?raidlock=" + strconv.Itoa(vm.Lock.Offset + 1)) } class="ml-2 text-bk-accent">(see previous)</a>
				</div>
			</header>
			for _, r := range vm.Raids {
				<section class="rounded-md border border-bk-border bg-bk-panel">
					<header class="flex items-center gap-3 border-b border-bk-border px-4 py-2">
						<img
							src={ viewhelpers.RaidIconHref(r.Name) }
							alt=""
							loading="lazy"
							width="36" height="36"
							class="rounded"
						/>
						<h2 class="text-sm font-medium uppercase tracking-wide text-bk-muted">{ r.Name }</h2>
					</header>
					<div class="p-4">
						@raidTable(vm.Realm, r, vm.Difficulties)
					</div>
				</section>
			}
			if len(vm.Raids) == 0 {
				<div class="rounded-md border border-bk-border bg-bk-panel p-6 text-center text-bk-muted">
					No kills recorded in this raid lock yet.
				</div>
			}
		</div>
	}
}

templ raidTable(realmName string, r Raid, difficulties []DifficultyChoice) {
	@components.Table() {
		<thead>
			<tr>
				<th>Boss</th>
				for _, d := range difficulties {
					<th class="text-right">{ d.Label }</th>
				}
				<th class="text-right">Total</th>
			</tr>
		</thead>
		<tbody>
			for _, b := range r.Bosses {
				<tr>
					<td>{ b.Name }</td>
					for _, d := range difficulties {
						<td class="text-right">
							if b.KillsByDifficulty[d.Mode] > 0 {
								<a href={viewhelpers.BossWithDifficultyHref(realmName, b.RemoteID, d.Mode)}>
									{ format.IntCtx(ctx, b.KillsByDifficulty[d.Mode]) }
								</a>
							} else {
								<span class="text-bk-muted">—</span>
							}
						</td>
					}
					<td class="text-right font-medium">
						{ format.IntCtx(ctx, b.Total) }
					</td>
				</tr>
			}
		</tbody>
	}
}
