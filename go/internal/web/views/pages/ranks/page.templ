package ranks

import (
	"strconv"

	"twinstar-bosskills/internal/format"
	"twinstar-bosskills/internal/links"
	"twinstar-bosskills/internal/web/views/components"
	"twinstar-bosskills/internal/web/views/layouts"
	"twinstar-bosskills/internal/web/views/viewhelpers"
)

type ViewModel struct {
	Meta         layouts.PageMeta
	Realm        string
	LockLabel    string
	LockOffset   int
	ClassMode    bool
	Difficulties []DifficultyChoice
	SelectedMode int
	ModeLabel    string
	DPSRaids     []RaidGroup
	HPSRaids     []RaidGroup
}

type DifficultyChoice struct {
	Mode  int
	Label string
}

type RaidGroup struct {
	Name   string
	Bosses []BossRankGroup
}

type BossRankGroup struct {
	BossID   uint32
	BossName string
	Entries  []Rank
}

type Rank struct {
	Rank      int
	Name      string
	Class     int
	ClassLabel string
	Spec      int
	SpecLabel string
	DPS       int64
	HPS       int64
	LengthSec int
	Ilvl      float32
	KillID    string
}

templ Page(vm ViewModel) {
	@layouts.Root(vm.Meta) {
		<div class="space-y-8">
			<header class="flex flex-wrap items-baseline gap-3">
				<h1 class="text-2xl font-semibold">{ vm.Realm } / Ranks</h1>
				<div class="ml-auto flex items-center gap-3">
					<span class="text-xs text-bk-muted">
						{ vm.LockLabel }
						<a href={ previousLockHref(vm) } class="ml-2 text-bk-accent">(see previous)</a>
					</span>
					@difficultyTabs(vm)
				</div>
			</header>
			<section class="space-y-6">
				<h2 class="text-lg font-semibold">Top DPS ranks — { vm.ModeLabel }</h2>
				if len(vm.DPSRaids) == 0 {
					@components.EmptyState("No DPS data for this week yet.")
				} else {
					for _, raid := range vm.DPSRaids {
						@raidSection(vm, raid, "DPS")
					}
				}
			</section>
			<section class="space-y-6">
				<h2 class="text-lg font-semibold">Top HPS ranks — { vm.ModeLabel }</h2>
				if len(vm.HPSRaids) == 0 {
					@components.EmptyState("No HPS data for this week yet.")
				} else {
					for _, raid := range vm.HPSRaids {
						@raidSection(vm, raid, "HPS")
					}
				}
			</section>
		</div>
	}
}

templ difficultyTabs(vm ViewModel) {
	if !vm.ClassMode {
		<div class="flex gap-1 text-xs">
			for _, d := range vm.Difficulties {
				<a href={ templ.SafeURL(links.Ranks(vm.Realm) + "?difficulty=" + strconv.Itoa(d.Mode) + "&raidlock=" + strconv.Itoa(vm.LockOffset)) }
				   class={ viewhelpers.TabActiveClass(d.Mode == vm.SelectedMode) }>
					{ d.Label }
				</a>
			}
		</div>
	}
}

templ raidSection(vm ViewModel, raid RaidGroup, metric string) {
	<div class="space-y-4">
		for _, boss := range raid.Bosses {
			<div>
				<h3 class="mb-2 font-medium">
					{ raid.Name } —
					<a href={ rankBossHref(vm, boss.BossID) } class="text-bk-accent hover:underline">{ boss.BossName }</a>
				</h3>
				@bossRankTable(vm, boss.Entries, metric)
			</div>
		}
	</div>
}

templ bossRankTable(vm ViewModel, rows []Rank, metric string) {
	if len(rows) == 0 {
		@components.EmptyState("No data yet.")
	} else {
		@components.Table() {
			<thead>
				<tr>
					<th class="w-8">#</th>
					<th>Character</th>
					<th>{ rankGroupLabel(vm) }</th>
					<th class="text-right">{ metric }</th>
					<th>Length</th>
					<th>iLvl</th>
					<th>Details</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr>
						<td class="text-bk-muted">{ viewhelpers.Itoa(r.Rank) }</td>
						<td>
							<a href={ viewhelpers.CharacterHref(vm.Realm, r.Name) } class="hover:underline">{ r.Name }</a>
						</td>
						<td class="text-xs">
							<span class="inline-flex items-center gap-1">
								if vm.ClassMode {
									@components.ClassSpecIcons(vm.Realm, r.Class, 0)
									<span>{ r.ClassLabel }</span>
								} else {
									@components.ClassSpecIcons(vm.Realm, r.Class, r.Spec)
									<span>{ r.SpecLabel }</span>
								}
							</span>
						</td>
						<td class="text-right">
							if metric == "DPS" {
								{ format.Int64Ctx(ctx, r.DPS) }
							} else {
								{ format.Int64Ctx(ctx, r.HPS) }
							}
						</td>
						<td>{ format.Duration(r.LengthSec) }</td>
						<td>{ viewhelpers.Ilvl(r.Ilvl) }</td>
						<td>
							if r.KillID != "" {
								<a href={ viewhelpers.BossKillHref(vm.Realm, r.KillID) }>Detail</a>
							}
						</td>
					</tr>
				}
			</tbody>
		}
	}
}
