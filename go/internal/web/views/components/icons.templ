package components

templ LatestIcon(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v5l3 2"></path><path d="M3.1 10a9 9 0 1 1 1.6 6.6"></path><path d="M3 16v-6h6"></path></svg>
}

templ RaidsIcon(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 4v5c0 4.5-2.9 7.6-7 9-4.1-1.4-7-4.5-7-9V7l7-4z"></path><path d="M9 12h6"></path><path d="M12 9v6"></path></svg>
}

