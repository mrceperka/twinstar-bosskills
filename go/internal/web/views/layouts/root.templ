package layouts

import (
	"strings"

	"github.com/mrceperka/twinstar-bosskills/go/internal/realm"
	"github.com/mrceperka/twinstar-bosskills/go/internal/web/static"
)

// Root is the base HTML layout. Pages compose it with `@layouts.Root(...) { ... }`.
// Subnav, page title and meta come in via PageMeta.
type PageMeta struct {
	Title       string
	Subtitle    string
	Realm       string // empty = no realm selected
	ActivePath  string // for highlighting nav links
	CSSHash     string // for cache-busting; "" disables
	JSHash      string
	IsHTMXBoot  bool
	NeedsChart  bool // include echarts + bk-chart if true
}

templ Root(meta PageMeta) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ pageTitle(meta) }</title>
			<link rel="icon" href={ faviconURL() } sizes="any"/>
			<link rel="stylesheet" href={ cssURL(meta) }/>
			<script src={ jsURL(meta, "htmx.min.js") } defer></script>
			<script src={ jsURL(meta, "bk-ui.js") } defer></script>
			if meta.NeedsChart {
				<script src={ jsURL(meta, "echarts.min.js") } defer></script>
				<script src={ jsURL(meta, "bk-chart.js") } defer></script>
			}
		</head>
		<body>
			@topbar(meta)
			<main>
				{ children... }
			</main>
			@footer()
		</body>
	</html>
}

templ topbar(meta PageMeta) {
	<header class="bk-topbar">
		<div class="flex items-center gap-3">
			// <a href="/" class="font-semibold tracking-wide">Twinstar Bosskills</a>
			if meta.Realm != "" {
				@realmPicker(meta.Realm)
			}
		</div>
		<nav>
			if meta.Realm != "" {
				<ul>
					<li><a href={ realmHref(meta.Realm, "/boss-kills") }>Latest</a></li>
					<li><a href={ realmHref(meta.Realm, "/raids") }>Raids</a></li>
					if realm.IsPublic(meta.Realm) && !realm.IsVanilla(realm.Expansion(meta.Realm)) {
						<li><a href={ realmHref(meta.Realm, "/ranks") }>Ranks</a></li>
					}
					<li><a href={ realmHref(meta.Realm, "/characters") }>Characters</a></li>
				</ul>
			}
		</nav>
		<div></div>
	</header>
}

templ realmPicker(activeRealm string) {
	<div class="bk-realm-picker" role="list" aria-label="Realm">
		for _, r := range realmPickerRealms() {
			<a
				href={ realmHref(r, "/") }
				class={ realmPickerClass(r, activeRealm) }
				aria-label={ "Realm " + r }
				role="listitem"
			>
				<img src={ realmLogoURL(r) } width="32" height="32" alt={ "Realm " + r + " icon" }/>
			</a>
		}
	</div>
}

templ footer() {
	<footer class="bk-footer">
		<a href="/changelog">🗒️ Changelog</a>
		<div>
			Made by hop and hopefully some others, maybe you?
			<a href="https://github.com/twinstar-bosskills/twinstar-bosskills" target="_blank" rel="noopener">
				We are open source ↗
			</a>
		</div>
	</footer>
}

func pageTitle(m PageMeta) string {
	if m.Title == "" {
		return "Twinstar Bosskills"
	}
	return m.Title + " — Twinstar Bosskills"
}

func faviconURL() templ.SafeURL {
	if h := static.Hash("favicon.ico"); h != "" {
		return templ.SafeURL("/favicon.ico?v=" + h)
	}
	return "/favicon.ico"
}

func cssURL(m PageMeta) string {
	if m.CSSHash == "" {
		return "/static/app.css"
	}
	return "/static/app.css?v=" + m.CSSHash
}

func jsURL(m PageMeta, name string) string {
	if h := static.Hash(name); h != "" {
		return "/static/" + name + "?v=" + h
	}
	if m.JSHash == "" {
		return "/static/" + name
	}
	return "/static/" + name + "?v=" + m.JSHash
}

func realmHref(realmName, suffix string) templ.SafeURL {
	return templ.SafeURL("/" + realmName + suffix)
}

func realmPickerRealms() []string {
	out := make([]string, 0, len(realm.All()))
	for _, r := range realm.All() {
		if realm.IsPublic(r) && realm.MergedTo(r) == "" {
			out = append(out, r)
		}
	}
	return out
}

func realmPickerClass(realmName, activeRealm string) string {
	if realm.Normalize(realmName) == realm.Normalize(activeRealm) {
		return "bk-realm-link active"
	}
	return "bk-realm-link"
}

func realmLogoURL(realmName string) templ.SafeURL {
	return templ.SafeURL("/static/logos/32x32/" + strings.ToLower(realm.Normalize(realmName)) + ".png")
}
